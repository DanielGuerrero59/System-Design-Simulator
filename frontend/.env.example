# Where the frontend sends /simulate.
#
# Not needed for local development: the client falls back to the backend's
# dev address, http://127.0.0.1:8000. Set it for a deployed build -- in
# Vercel under Project > Settings > Environment Variables -- to the backend's
# public URL, with no trailing slash.
#
# Vite inlines VITE_* variables at build time, so this is baked into the bundle:
# changing it means rebuilding, not restarting. To override locally, copy this
# file to .env.local (gitignored) and edit the value.
VITE_API_BASE_URL=https://your-api.up.railway.app
